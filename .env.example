# Database Credentials (được truyền vào mongodb)
MONGO_INITDB_ROOT_USERNAME=your_mongo_admin_username
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password

# API Configuration (được truyền vào API)
PORT=3000
MONGODB_URI=mongodb://your_mongo_admin_username:your_secure_mongo_password@mongodb:27017/kpi_management?authSource=admin
JWT_SECRET=your_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Admin seed / reset (dùng cho npm run seed:admin | reset:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Strong1
ADMIN_EMPLOYEE_CODE=ADMIN001
ADMIN_FULL_NAME=System Admin

# Login protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
